# ── AWS Credentials ─────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=us-east-1
S3_BUCKET=fraud-detection-bucket

# ── AI / LLM ─────────────────────────────────────────────────────────────────
# Required for RAG explanations via Anthropic Claude
ANTHROPIC_API_KEY=your_anthropic_key

# ── MLflow ───────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000

# ── Streaming / Messaging ────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
REDIS_URL=redis://localhost:6379

# ── Flask API ────────────────────────────────────────────────────────────────
FLASK_ENV=production
SECRET_KEY=change-this-to-a-long-random-string-in-production
# Optional API key authentication (leave blank to disable)
API_KEY=

# ── Fraud Scoring Thresholds (overrides app defaults) ────────────────────────
THRESHOLD_CRITICAL=0.90
THRESHOLD_HIGH=0.70
THRESHOLD_MEDIUM=0.50
THRESHOLD_LOW=0.30

# ── Model Paths ───────────────────────────────────────────────────────────────
MODEL_DIR=models/
FEEDBACK_LOG_PATH=feedback.jsonl

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8001

# ── Airflow ───────────────────────────────────────────────────────────────────
AIRFLOW_HOME=/opt/airflow
